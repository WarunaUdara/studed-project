                  },
                  {
                    "id": "higher-emf",
                    "label": "The EMF of the cell rises",
                    "onLabel": "true",
                    "offLabel": "false"
                  }
                ]
              }
            },
            {
              "id": "al-eb-4-3",
              "type": "order_steps",
              "question": "Order the terminal voltage from lowest to highest as the load changes.",
              "correctAnswer": "short>normal>open",
