        {
          "title": "2. Capacitors: Charge, Not Current",
          "sequenceOrder": 2,
          "status": "published",
          "xpReward": 65,
          "maxReattempts": 3,
          "passingThreshold": 60,
          "estimatedDuration": 12,
          "difficulty": "HARD",
          "learnBlocks": [
            {
              "id": "al-5-1",
              "type": "blob_dialog",
              "content": "A capacitor does not store current. It stores charge, and its voltage grows as it fills.",
              "metadata": {
                "version": 1,
                "lines": [
                  {
                    "id": "l1",
                    "text": "A capacitor does not store current. It stores charge, and its voltage grows as it fills.",
                    "mood": "thinking",
                    "cta": "So it fights back?"
                  },
                  {
                    "id": "l2",
                    "text": "It does. As the voltage climbs, the charging current falls away exponentially.",
                    "mood": "happy",
                    "cta": "Never quite full?"
                  },
                  {
                    "id": "l3",
                    "text": "In theory never. In practice five time constants is treated as fully charged.",
                    "mood": "cheer",
                    "cta": "Useful shortcut"
                  }
                ]
              }
            },
            {
              "id": "al-5-2",
              "type": "formula",
              "content": "Q = CV \\qquad E = \\tfrac{1}{2}CV^2 \\qquad \\tau = RC"
            },
            {
              "id": "al-5-3",
              "type": "text",
              "content": "The time constant is a product of resistance and capacitance. A bigger resistor charges the same capacitor more slowly, because it limits the current doing the filling."
            }
          ],
          "evaluateBlocks": [
            {
              "id": "al-eb-5-1",
              "type": "tap_target",
              "question": "A 100 microfarad capacitor is charged to 12 V. What charge does it hold?",
              "correctAnswer": "twelve-hundred",
              "explanation": "Q = CV = 100 microfarad x 12 V = 1.2 millicoulomb.",
              "metadata": {
                "version": 1,
                "targets": [
                  {
                    "id": "twelve-hundred",
                    "label": "1.2 millicoulomb"
                  },
                  {
                    "id": "eight",
                    "label": "8.3 coulomb"
                  },
                  {
                    "id": "twelve",
                    "label": "12 coulomb"
                  },
                  {
                    "id": "hundred",
                    "label": "100 coulomb"
                  }
                ]
              }
            },
            {
              "id": "al-eb-5-2",
              "type": "drag_drop",
              "question": "Match each change to its effect on the charging time constant.",
              "correctAnswer": "slot-bigger-r:longer,slot-higher-v:no-change,slot-smaller-c:shorter",
              "explanation": "The time constant is R times C, so the supply voltage changes the final charge but never the rate of filling.",
              "metadata": {
                "version": 1,
                "items": [
                  {
                    "id": "longer",
                    "label": "Makes it longer"
                  },
                  {
                    "id": "shorter",
                    "label": "Makes it shorter"
                  },
                  {
                    "id": "no-change",
                    "label": "Leaves it unchanged"
                  }
                ],
                "slots": [
                  {
                    "id": "slot-bigger-r",
                    "label": "Using a bigger series resistor"
                  },
                  {
                    "id": "slot-smaller-c",
                    "label": "Using a smaller capacitor"
                  },
                  {
                    "id": "slot-higher-v",
                    "label": "Using a higher supply voltage"
                  }
                ]
              }
            },
            {
              "id": "al-eb-5-3",
              "type": "toggle_switch",
              "question": "Switch on the statements that are true during charging.",
              "correctAnswer": "current-falls=on,steady-current=off,voltage-rises=on",
              "explanation": "The rising capacitor voltage opposes the supply, so the current decays as the voltage climbs.",
              "metadata": {
                "version": 1,
                "switches": [
                  {
                    "id": "current-falls",
                    "label": "The charging current falls with time",
                    "onLabel": "true",
                    "offLabel": "false"
                  },
                  {
                    "id": "voltage-rises",
                    "label": "The capacitor voltage rises with time",
                    "onLabel": "true",
                    "offLabel": "false"
                  },
                  {
                    "id": "steady-current",
                    "label": "The current stays constant until it is full",
                    "onLabel": "true",
                    "offLabel": "false"
                  }
                ]
              }
            }
          ]
        },
