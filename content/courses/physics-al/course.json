              "id": "al-3-1",
              "type": "blob_dialog",
              "content": "There is no such thing as centrifugal force pushing you outwards.",
              "metadata": {
                "version": 1,
                "lines": [
                  {
                    "id": "l1",
                    "text": "There is no such thing as centrifugal force pushing you outwards.",
                    "mood": "surprised",
                    "cta": "But I feel it"
                  },
                  {
                    "id": "l2",
                    "text": "What you feel is your own inertia. The real force points inwards, towards the centre.",
                    "mood": "thinking",
                    "cta": "Always inwards?"
                  },
                  {
                    "id": "l3",
                    "text": "Always. Friction, tension or gravity provides it. Remove it and the object goes straight, not outwards.",
                    "mood": "cheer",
                    "cta": "That is the exam answer"
                  }
                ]
              }
            },
            {
              "id": "al-3-2",
              "type": "formula",
              "content": "a = \\frac{v^2}{r} \\qquad F = \\frac{mv^2}{r}"
            },
            {
              "id": "al-3-3",
              "type": "text",
              "content": "Name the force doing the job before you use the formula. In a car it is friction, on a string it is tension, and for a satellite it is gravity."
            }
          ],
          "evaluateBlocks": [
