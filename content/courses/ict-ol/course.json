              "id": "ictol-5-1",
              "type": "blob_dialog",
              "content": "A query says what you want, not how to find it. The database works out the how.",
              "metadata": {
                "version": 1,
                "lines": [
                  {
                    "id": "l1",
                    "text": "A query says what you want, not how to find it. The database works out the how.",
                    "mood": "thinking",
                    "cta": "Which parts?"
                  },
                  {
                    "id": "l2",
                    "text": "SELECT the columns, FROM the table, WHERE the condition holds.",
                    "mood": "happy",
                    "cta": "In that order?"
                  },
                  {
                    "id": "l3",
                    "text": "Written in that order, yes. The database applies WHERE before it hands you the columns.",
                    "mood": "cheer",
                    "cta": "Good to know"
                  }
                ]
              }
            },
            {
              "id": "ictol-5-2",
              "type": "code",
              "content": "SELECT name, grade\nFROM Student\nWHERE grade = 11\nORDER BY name;"
            },
            {
              "id": "ictol-5-3",
              "type": "text",
              "content": "**SELECT** chooses columns, **WHERE** filters rows, **ORDER BY** sorts what is left. Filtering happens before sorting, which is why a filtered query sorts faster."
            }
          ],
