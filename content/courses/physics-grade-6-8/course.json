          "learnBlocks": [
            {
              "id": "p68-1-1",
              "type": "blob_dialog",
              "content": "You already know this one. A small child can lift a big adult on a see-saw.",
              "metadata": {
                "version": 1,
                "lines": [
                  {
                    "id": "l1",
                    "text": "You already know this one. A small child can lift a big adult on a see-saw.",
                    "mood": "happy",
                    "cta": "How?"
                  },
                  {
                    "id": "l2",
                    "text": "By sitting further out. Distance from the middle counts just as much as weight.",
                    "mood": "thinking",
                    "cta": "Really?"
                  },
                  {
                    "id": "l3",
                    "text": "Weight times distance is called the turning effect, or the moment.",
                    "mood": "happy",
                    "cta": "Show me"
                  },
                  {
                    "id": "l4",
                    "text": "Balance the beam below. Try a light weight far out against a heavy one close in.",
                    "mood": "cheer",
                    "cta": "Let me try"
                  }
                ]
              }
            },
            {
              "id": "p68-1-2",
              "type": "lever_lab",
              "content": "Pick a weight, then tap a notch to hang it.",
              "metadata": {
                "version": 1,
                "notches": 4,
                "weights": [
                  2,
                  4,
                  6
                ],
                "left": {
                  "position": -3,
                  "weight": 4
                },
                "right": null,
                "caption": "Both sides balance when weight times distance is the same on each side."
              }
            },
            {
              "id": "p68-1-3",
              "type": "text",
              "content": "**Turning effect = weight x distance from the pivot.** Double the distance and you halve the weight you need."
            }
          ],
          "evaluateBlocks": [
