          "difficulty": "EASY",
          "learnBlocks": [
            {
              "id": "p68-4-1",
              "type": "blob_dialog",
              "content": "Energy is not a thing you can hold. It is what makes changes happen.",
              "metadata": {
                "version": 1,
                "lines": [
                  {
                    "id": "l1",
                    "text": "Energy is not a thing you can hold. It is what makes changes happen.",
                    "mood": "thinking",
                    "cta": "Like what?"
                  },
                  {
                    "id": "l2",
                    "text": "A torch turns chemical energy in the cell into light and a bit of heat.",
                    "mood": "happy",
                    "cta": "Okay"
                  },
                  {
                    "id": "l3",
                    "text": "Energy never disappears. It only changes into a different form.",
                    "mood": "happy",
                    "cta": "Always?"
                  },
                  {
                    "id": "l4",
                    "text": "Always. Even when it seems lost, it has turned into heat somewhere.",
                    "mood": "cheer",
                    "cta": "Got it"
                  }
                ]
              }
            },
            {
              "id": "p68-4-2",
              "type": "text",
              "content": "The forms you will meet most: **movement**, **heat**, **light**, **sound**, **electrical**, and **stored** energy in food, fuel and stretched springs."
