          "learnBlocks": [
            {
              "id": "p68-3-1",
              "type": "blob_dialog",
              "content": "A crowbar is just a lever. So is a wheelbarrow, and so are scissors.",
              "metadata": {
                "version": 1,
                "lines": [
                  {
                    "id": "l1",
                    "text": "A crowbar is just a lever. So is a wheelbarrow, and so are scissors.",
                    "mood": "happy",
                    "cta": "All of them?"
                  },
                  {
                    "id": "l2",
                    "text": "Each one lets a small push do a big job, by trading distance for force.",
                    "mood": "thinking",
                    "cta": "Trading?"
                  },
                  {
                    "id": "l3",
                    "text": "You push a long way with a small force, and the load moves a short way with a big one.",
                    "mood": "happy",
                    "cta": "Clever"
                  }
                ]
              }
            },
            {
              "id": "p68-3-2",
              "type": "animation",
              "content": "lever-balance",
              "metadata": {
                "version": 1,
                "scene": "lever-balance",
                "params": {
                  "leftWeight": 1,
                  "leftPosition": 6,
                  "rightWeight": 6,
                  "rightPosition": 1,
                  "notches": 6
                },
                "caption": "This is what a crowbar does: a small force at the far end lifts a heavy load close to the pivot."
              }
            },
            {
              "id": "p68-3-3",
              "type": "text",
              "content": "A lever never gives you free energy. It gives you a **bigger force over a shorter distance**, which is a trade, not a gift."
            },
            {
              "id": "p68-3-4",
              "type": "callout",
              "content": "This is why a longer spanner loosens a stuck bolt. The extra length multiplies your turning effect."
            }
