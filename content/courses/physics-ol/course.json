              "id": "ol-6-1",
              "type": "blob_dialog",
              "content": "Energy questions are accounting. Whatever went in has to appear somewhere afterwards.",
              "metadata": {
                "version": 1,
                "lines": [
                  {
                    "id": "l1",
                    "text": "Energy questions are accounting. Whatever went in has to appear somewhere afterwards.",
                    "mood": "thinking",
                    "cta": "Including waste?"
                  },
                  {
                    "id": "l2",
                    "text": "Especially waste. Efficiency is just useful output divided by total input.",
                    "mood": "happy",
                    "cta": "As a percentage?"
                  },
                  {
                    "id": "l3",
                    "text": "As a percentage, and it can never exceed one hundred. If yours does, a number is in the wrong place.",
                    "mood": "cheer",
                    "cta": "Good check"
                  }
                ]
              }
            },
            {
              "id": "ol-6-2",
              "type": "formula",
              "content": "efficiency = \\frac{useful\\ output}{total\\ input} \\times 100\\%"
            },
            {
              "id": "ol-6-3",
              "type": "force_lab",
              "content": "Push the cart on a rough surface. The push you feel is the input; the movement is the useful output.",
