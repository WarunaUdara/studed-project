          "title": "1. Analysing a Circuit Step by Step",
          "sequenceOrder": 1,
          "status": "published",
          "xpReward": 55,
          "maxReattempts": 3,
          "passingThreshold": 60,
          "estimatedDuration": 10,
          "difficulty": "MEDIUM",
          "learnBlocks": [
            {
              "id": "ol-1-1",
              "type": "blob_dialog",
              "content": "Circuit questions look different every year and are solved the same way every year.",
              "metadata": {
                "version": 1,
                "lines": [
                  {
                    "id": "l1",
                    "text": "Circuit questions look different every year and are solved the same way every year.",
                    "mood": "thinking",
                    "cta": "How?"
                  },
                  {
                    "id": "l2",
                    "text": "Reduce the network to one resistance, find the total current, then work back to the part you were asked about.",
                    "mood": "happy",
                    "cta": "Always in that order?"
                  },
                  {
                    "id": "l3",
                    "text": "Always. Jumping straight to the part you want is where the marks are lost.",
                    "mood": "cheer",
                    "cta": "Noted"
                  }
                ]
              }
            },
            {
              "id": "ol-1-2",
              "type": "ohms_law_lab",
              "content": "Use the bench as your reduced circuit. Set the total resistance you calculated and read the supply current.",
              "metadata": {
                "version": 1,
                "voltage": 12,
                "resistance": 6,
                "maxVoltage": 12,
                "maxResistance": 12,
                "caption": "Once the network is one resistance, the supply current is a single division."
              }
            },
            {
              "id": "ol-1-3",
              "type": "formula",
              "content": "R_{total} = R_1 + R_2 \\qquad I_{supply} = \\frac{V}{R_{total}}"
            },
            {
              "id": "ol-1-4",
              "type": "callout",
              "content": "Write the reduced resistance down before you touch a calculator. Examiners award method marks for it even when the arithmetic slips."
            }
          ],
          "evaluateBlocks": [
            {
              "id": "ol-eb-1-1",
              "type": "order_steps",
              "question": "Put the circuit analysis steps in the order that earns method marks.",
              "correctAnswer": "reduce>total>split>answer",
              "explanation": "Each step feeds the next, and each one on the page is a mark, even if the final number is wrong.",
              "metadata": {
                "version": 1,
                "steps": [
                  {
                    "id": "reduce",
                    "label": "Reduce the network to one resistance"
                  },
                  {
                    "id": "total",
                    "label": "Find the total current from the supply"
                  },
                  {
                    "id": "split",
                    "label": "Split the current or voltage between the branches"
                  },
                  {
                    "id": "answer",
                    "label": "Answer the quantity actually asked for"
                  }
                ]
              }
            },
