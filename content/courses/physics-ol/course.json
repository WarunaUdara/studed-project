                  },
                  {
                    "id": "bigger-r-smaller-v",
                    "label": "The bigger resistor takes the smaller voltage",
                    "onLabel": "valid check",
                    "offLabel": "not a check"
                  }
                ]
              }
            },
            {
              "id": "ol-eb-2-3",
              "type": "slider_target",
              "question": "Two equal resistors sit in series across 10 V. What voltage is across one of them?",
              "correctAnswer": "five",
              "explanation": "Equal resistances take equal shares, so each one takes half of the supply.",
              "metadata": {
                "version": 1,
                "min": 0,
                "max": 10,
