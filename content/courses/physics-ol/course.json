        {
          "title": "2. Where the Voltage Goes",
          "sequenceOrder": 2,
          "status": "published",
          "xpReward": 55,
          "maxReattempts": 3,
          "passingThreshold": 60,
          "estimatedDuration": 10,
          "difficulty": "MEDIUM",
          "learnBlocks": [
            {
              "id": "ol-2-1",
              "type": "blob_dialog",
              "content": "In a series circuit the supply voltage is shared out, and it is shared in proportion to resistance.",
              "metadata": {
                "version": 1,
                "lines": [
                  {
                    "id": "l1",
                    "text": "In a series circuit the supply voltage is shared out, and it is shared in proportion to resistance.",
                    "mood": "happy",
                    "cta": "Why proportion?"
                  },
                  {
                    "id": "l2",
                    "text": "Because the current is the same everywhere, so V equals I times R gives a bigger share to a bigger resistor.",
                    "mood": "thinking",
                    "cta": "That follows"
                  },
                  {
                    "id": "l3",
                    "text": "Add up the shares and you get the supply back. That is your check.",
                    "mood": "cheer",
                    "cta": "Useful"
                  }
                ]
              }
            },
            {
              "id": "ol-2-2",
              "type": "ohms_law_lab",
              "content": "Set the total resistance, note the current, then work out each resistor's share of the voltage.",
              "metadata": {
                "version": 1,
                "voltage": 9,
                "resistance": 9,
                "maxVoltage": 12,
                "maxResistance": 12,
                "caption": "One current, then a share of voltage for each resistor in the chain."
              }
            },
            {
              "id": "ol-2-3",
              "type": "formula",
              "content": "V_1 = IR_1 \\qquad V_1 + V_2 = V_{supply}"
            }
          ],
          "evaluateBlocks": [
            {
              "id": "ol-eb-2-1",
              "type": "tap_target",
              "question": "A 9 V supply drives 1 A through a 3 ohm and a 6 ohm resistor in series. What is the voltage across the 6 ohm resistor?",
              "correctAnswer": "six",
              "explanation": "V = IR = 1 x 6 = 6 V, and the remaining 3 V sits across the 3 ohm resistor.",
              "metadata": {
                "version": 1,
                "targets": [
                  {
                    "id": "six",
                    "label": "6 V"
                  },
                  {
                    "id": "three",
                    "label": "3 V"
                  },
                  {
                    "id": "nine",
                    "label": "9 V"
                  },
                  {
                    "id": "one-and-half",
                    "label": "1.5 V"
                  }
                ]
              }
            },
            {
              "id": "ol-eb-2-2",
              "type": "toggle_switch",
              "question": "Switch on the checks that show your circuit answer is consistent.",
              "correctAnswer": "bigger-r-smaller-v=off,same-current=on,sum=on",
              "explanation": "Voltages must sum to the supply and the series current is common, but a bigger resistance takes a bigger share of voltage, not a smaller one.",
              "metadata": {
                "version": 1,
                "switches": [
                  {
                    "id": "sum",
                    "label": "The branch voltages add up to the supply",
                    "onLabel": "valid check",
                    "offLabel": "not a check"
