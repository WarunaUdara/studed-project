        {
          "title": "2. Series and Parallel",
          "sequenceOrder": 2,
          "status": "published",
          "xpReward": 55,
          "maxReattempts": 0,
          "passingThreshold": 60,
          "estimatedDuration": 10,
          "difficulty": "MEDIUM",
          "learnBlocks": [
            {
              "id": "p911-2-1",
              "type": "blob_dialog",
              "content": "Add a second resistor in a line and the current has to fight through both.",
              "metadata": {
                "version": 1,
                "lines": [
                  {
                    "id": "l1",
                    "text": "Add a second resistor in a line and the current has to fight through both.",
                    "mood": "thinking",
                    "cta": "So more resistance?"
                  },
                  {
                    "id": "l2",
                    "text": "Yes. In series you add the resistances, and the current is the same everywhere.",
                    "mood": "happy",
                    "cta": "And parallel?"
                  },
                  {
                    "id": "l3",
                    "text": "In parallel you give the current a second road, so the total resistance drops below either one.",
                    "mood": "surprised",
                    "cta": "Below both?"
                  },
                  {
                    "id": "l4",
                    "text": "Below the smaller one. Two roads always carry more traffic than one.",
                    "mood": "cheer",
                    "cta": "Gotcha"
                  }
                ]
              }
            },
            {
              "id": "p911-2-2",
              "type": "ohms_law_lab",
              "content": "Treat the resistance slider as the total. Try 4 ohm, then 8 ohm as if you added a second resistor in series.",
              "metadata": {
                "version": 1,
                "voltage": 12,
                "resistance": 4,
                "maxVoltage": 12,
                "maxResistance": 12,
                "caption": "Series adds up: two 4 ohm resistors behave like a single 8 ohm one, halving the current."
              }
            },
            {
              "id": "p911-2-3",
              "type": "formula",
              "content": "R_{series} = R_1 + R_2 \\qquad \\frac{1}{R_{parallel}} = \\frac{1}{R_1} + \\frac{1}{R_2}"
            },
            {
              "id": "p911-2-4",
              "type": "callout",
              "content": "Two identical resistors in parallel give exactly half of one resistance. That single case answers a large share of O/L questions."
            }
          ],
          "evaluateBlocks": [
            {
              "id": "p911-eb-2-1",
              "type": "tap_target",
              "question": "Two 6 ohm resistors are connected in parallel. What is the total resistance?",
              "correctAnswer": "three",
              "explanation": "Two identical resistors in parallel halve the resistance, so 6 ohm becomes 3 ohm.",
              "metadata": {
                "version": 1,
                "targets": [
                  {
                    "id": "three",
                    "label": "3 ohm"
                  },
                  {
                    "id": "twelve",
                    "label": "12 ohm"
                  },
                  {
                    "id": "six",
                    "label": "6 ohm"
                  },
                  {
                    "id": "one",
                    "label": "1 ohm"
                  }
                ]
              }
            },
            {
              "id": "p911-eb-2-2",
              "type": "toggle_switch",
              "question": "Switch on what is true of a series circuit.",
              "correctAnswer": "lower-total=off,same-current=on,shared-voltage=on",
              "explanation": "One path means one current, the voltage divides across the parts, and adding resistance in series always raises the total.",
              "metadata": {
                "version": 1,
                "switches": [
                  {
                    "id": "same-current",
                    "label": "The current is the same through every part",
                    "onLabel": "true",
                    "offLabel": "false"
                  },
                  {
                    "id": "shared-voltage",
                    "label": "The supply voltage is shared between the parts",
                    "onLabel": "true",
                    "offLabel": "false"
                  },
                  {
                    "id": "lower-total",
                    "label": "Adding a resistor lowers the total resistance",
                    "onLabel": "true",
                    "offLabel": "false"
                  }
                ]
              }
            },
            {
              "id": "p911-eb-2-3",
              "type": "order_steps",
              "question": "Put these totals in order, smallest first.",
              "correctAnswer": "parallel>single>series",
              "explanation": "Parallel gives 2 ohm, the single resistor is 4 ohm, and series gives 8 ohm.",
              "metadata": {
                "version": 1,
                "steps": [
                  {
                    "id": "parallel",
