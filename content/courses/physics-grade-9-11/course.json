          "learnBlocks": [
            {
              "id": "p911-1-1",
              "type": "blob_dialog",
              "content": "Three quantities, one relationship, and most mistakes come from mixing up which one you control.",
              "metadata": {
                "version": 1,
                "lines": [
                  {
                    "id": "l1",
                    "text": "Three quantities, one relationship, and most mistakes come from mixing up which one you control.",
                    "mood": "thinking",
                    "cta": "Which ones?"
                  },
                  {
                    "id": "l2",
                    "text": "You set the supply voltage. You choose the resistor. The current is what is left over.",
                    "mood": "happy",
                    "cta": "So current is the result?"
                  },
                  {
                    "id": "l3",
                    "text": "Exactly. Current is never something you dial in directly. Prove it on the bench below.",
                    "mood": "cheer",
                    "cta": "Let me try"
                  }
                ]
              }
            },
            {
              "id": "p911-1-2",
              "type": "ohms_law_lab",
              "content": "Set the supply and the resistor, then read the ammeter.",
              "metadata": {
                "version": 1,
                "voltage": 6,
                "resistance": 3,
                "maxVoltage": 12,
                "maxResistance": 12,
                "caption": "Double the voltage and the current doubles. Double the resistance and it halves."
              }
            },
            {
              "id": "p911-1-3",
              "type": "formula",
              "content": "I = \\frac{V}{R}"
            },
            {
              "id": "p911-1-4",
              "type": "text",
              "content": "Rearranged: **V = IR** and **R = V/I**. All three say the same thing, so pick whichever one leaves the unknown alone on the left."
            }
          ],
          "evaluateBlocks": [
            {
