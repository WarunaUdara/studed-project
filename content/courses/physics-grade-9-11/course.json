        {
          "title": "3. Putting Motion to Work",
          "sequenceOrder": 3,
          "status": "published",
          "xpReward": 60,
          "maxReattempts": 0,
          "passingThreshold": 60,
          "estimatedDuration": 11,
          "difficulty": "HARD",
          "learnBlocks": [
            {
              "id": "p911-6-1",
              "type": "blob_dialog",
              "content": "Exam questions rarely hand you the right equation. They hand you three quantities.",
              "metadata": {
                "version": 1,
                "lines": [
                  {
                    "id": "l1",
                    "text": "Exam questions rarely hand you the right equation. They hand you three quantities.",
                    "mood": "thinking",
                    "cta": "Then what?"
                  },
                  {
                    "id": "l2",
                    "text": "Write down what you have and what you want, then pick the equation that connects them.",
                    "mood": "happy",
                    "cta": "Every time?"
                  },
                  {
                    "id": "l3",
                    "text": "Every time. The equation you need is the one with no extra unknowns in it.",
                    "mood": "cheer",
                    "cta": "That is the trick"
                  }
                ]
              }
            },
            {
              "id": "p911-6-2",
              "type": "formula",
              "content": "v = u + at \\qquad s = ut + \\tfrac{1}{2}at^2 \\qquad v^2 = u^2 + 2as"
            },
            {
              "id": "p911-6-3",
              "type": "text",
              "content": "Each of the three equations leaves out one quantity. Choose the one that leaves out whatever you were not given and do not need."
            }
          ],
          "evaluateBlocks": [
            {
              "id": "p911-eb-6-1",
              "type": "order_steps",
              "question": "Put the solving steps in the order that avoids mistakes.",
              "correctAnswer": "list>pick>substitute>check",
              "explanation": "Listing first is what makes the right equation obvious, and checking the size catches a slipped decimal point.",
              "metadata": {
                "version": 1,
                "steps": [
                  {
