          "title": "2. Reading a Motion Graph",
          "sequenceOrder": 2,
          "status": "published",
          "xpReward": 55,
          "maxReattempts": 0,
          "passingThreshold": 60,
          "estimatedDuration": 10,
          "difficulty": "MEDIUM",
          "learnBlocks": [
            {
              "id": "p911-5-1",
              "type": "blob_dialog",
              "content": "Graphs give up their meaning through gradients and areas. Learn those two and you can read any of them.",
              "metadata": {
                "version": 1,
                "lines": [
                  {
                    "id": "l1",
                    "text": "Graphs give up their meaning through gradients and areas. Learn those two and you can read any of them.",
                    "mood": "thinking",
                    "cta": "Which is which?"
                  },
                  {
                    "id": "l2",
                    "text": "On a distance-time graph, the gradient is the speed.",
                    "mood": "happy",
                    "cta": "And on velocity-time?"
                  },
                  {
                    "id": "l3",
                    "text": "The gradient is the acceleration, and the area underneath is the distance travelled.",
                    "mood": "cheer",
                    "cta": "Two for one"
                  }
                ]
              }
            },
            {
              "id": "p911-5-2",
              "type": "text",
              "content": "**Distance-time**: flat means stopped, steeper means faster.\n\n**Velocity-time**: flat means steady speed, sloping up means speeding up, and the area under the line is the distance covered."
            },
            {
              "id": "p911-5-3",
              "type": "callout",
              "content": "A flat line means opposite things on the two graphs. Check the axis labels before you read anything else."
            }
          ],
          "evaluateBlocks": [
