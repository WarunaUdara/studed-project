# Upload Service
UPLOAD_SERVICE_ADDR=:8093

# Object storage.
#   - Set GCS_BUCKET_NAME alone  -> real Google Cloud Storage (Workload Identity).
#   - Add STORAGE_EMULATOR_HOST  -> local emulator; the bucket is auto-created.
#   - Set neither                -> local disk under UPLOAD_LOCAL_DIR (dev only).
GCS_BUCKET_NAME=studed-uploads-local
STORAGE_EMULATOR_HOST=http://localhost:4443

# Where disk-mode objects are written. Must be writable when the container runs
# with a read-only root filesystem, so keep it under /tmp.
UPLOAD_LOCAL_DIR=/tmp/studed-uploads

# Required for POST/DELETE. The api-gateway attaches this after it has
# authenticated the educator; the service refuses all writes if it is unset.
SERVICE_TOKEN=local-dev-service-token-secret

# 10MiB. Requests above this are rejected with 413 while still streaming.
UPLOAD_MAX_BYTES=10485760

# Comma-separated MIME allowlist, matched against sniffed content (not the
# filename). Defaults to image/jpeg,image/png,image/webp,image/gif.
# UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# Optional absolute prefix for returned URLs. Leave empty to return paths
# relative to the gateway (recommended).
# UPLOAD_PUBLIC_BASE_URL=https://api.example.com
