scalar DateTime

enum Role {
  STUDENT
  EDUCATOR
  HEAD_EDUCATOR
  ADMIN
}

enum Grade {
  G1
  G2
  G3
  G4
  G5
  G6
  G7
  G8
  G9
  G10
  G11
  OL
  AL
}

enum VizType {
  MANIM
  THREEDMOL
  TSCIRCUIT
  MATTERJS
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProgressStatus {
  LOCKED
  AVAILABLE
  STARTED
  COMPLETED
}

enum Tier {
  BASIC
  STANDARD
  PREMIUM
  SCHOOL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

type User {
  id: ID!
  email: String!
  fullName: String!
  role: Role!
  grade: Grade
  preferredLanguage: String!
  subscription: UserSubscription
  totalXp: Int!
  "Consecutive days of learning. Advanced by activity, never by page loads."
  streak: Int!
  longestStreak: Int!
  "The last day the student learned. Lets a week view mark real days."
  lastActiveAt: DateTime
  createdAt: DateTime!
}

type Course {
  id: ID!
  title: String!
  description: String!
  slug: String!
  gradeLevel: Grade!
  educator: User!
  price: Float
  isPublished: Boolean!
  lessons: [Lesson!]!
  myProgress: CourseProgress
  createdAt: DateTime!
}

type Lesson {
  id: ID!
  course: Course!
  title: String!
  sequenceOrder: Int!
  waves: [Wave!]!
  isPublished: Boolean!
}

type Wave {
  id: ID!
  lesson: Lesson!
  title: String!
  sequenceOrder: Int!
  xpReward: Int!
  maxReattempts: Int!
  passingThreshold: Int!
  estimatedDuration: Int!
  difficulty: Difficulty!
  learnBlocks: [LearnBlock!]!
  evaluateBlocks: [EvaluateBlock!]!
  myProgress: WaveProgress
  isPublished: Boolean!
}

type LearnBlock {
  id: ID!
  type: String!
  content: String!
  metadata: String
}

type EvaluateBlock {
  id: ID!
  type: String!
  question: String!
  options: [String!]
  correctAnswer: String
  explanation: String
  metadata: String
}

type WaveProgress {
  status: ProgressStatus!
  attemptsCount: Int!
  highestScore: Int
  completedAt: DateTime
  lastAttemptedAt: DateTime
}

type CourseProgress {
  completedWaves: Int!
  totalWaves: Int!
  startedAt: DateTime
  completedAt: DateTime
}

type LessonProgress {
  lesson: Lesson!
  completedWaves: Int!
  totalWaves: Int!
}

"""
One place on a leaderboard. It carries a display name rather than a User:
a ranked row is not a user profile, and building a half-empty User to hold a
name invited the rest of the profile to leak alongside it.
"""
type LeaderboardEntry {
  "Competition standard: equal XP shares a rank, the next total skips."
  rank: Int!
  userId: ID!
  "Masked for display, e.g. \"Nimal P.\" — never the student's legal name."
  displayName: String!
  totalXp: Int!
  isMe: Boolean!
}

type LeaderboardPage {
  entries: [LeaderboardEntry!]!
  "Everyone ranked in this scope, not just this page. Drives top-N% badges."
  totalRanked: Int!
  """
  The viewer's own standing, present even when they fall outside the page.
  Null only when they have not scored in this scope yet.
  """
  me: LeaderboardEntry
}

type UserSubscription {
  id: ID!
  tier: Tier!
  status: SubscriptionStatus!
  startDate: DateTime!
  endDate: DateTime!
}

"""
An achievement from the server-owned catalog. Locked ones are returned too, so
the UI can show what is still to earn without duplicating the unlock rules.
"""
type Achievement {
  id: ID!
  name: String!
  description: String!
  iconUrl: String
  unlocked: Boolean!
  "Null while the achievement is still locked."
  unlockedAt: DateTime
}

input CourseFilter {
  grade: Grade
  subject: String
  search: String
  isPublished: Boolean
}

input PaginationInput {
  first: Int = 20
  after: String
}

type CourseEdge {
  node: Course!
  cursor: String!
}

type CourseConnection {
  edges: [CourseEdge!]!
  pageInfo: PageInfo!
}

type PageInfo {
  hasNextPage: Boolean!
  endCursor: String
}

input RegisterInput {
  email: String!
  password: String!
  fullName: String!
  grade: Grade
  preferredLanguage: String
}

input LoginInput {
  email: String!
  password: String!
}

type AuthPayload {
  accessToken: String!
  refreshToken: String!
  user: User!
}

input CreateCourseInput {
  title: String!
  description: String!
  slug: String!
  gradeLevel: Grade!
  price: Float
}

input UpdateCourseInput {
  title: String
  description: String
  slug: String
  gradeLevel: Grade
  price: Float
}

input CreateLessonInput {
  title: String!
  sequenceOrder: Int!
}

input UpdateLessonInput {
  title: String
  sequenceOrder: Int
}

input LearnBlockInput {
  id: ID!
  type: String!
  content: String!
  metadata: String
}

input EvaluateBlockInput {
  id: ID!
  type: String!
  question: String!
  options: [String!]
  correctAnswer: String
  explanation: String
  metadata: String
}

input CreateWaveInput {
  title: String!
  sequenceOrder: Int!
  xpReward: Int!
  maxReattempts: Int!
  passingThreshold: Int!
  estimatedDuration: Int!
  difficulty: Difficulty!
  learnBlocks: [LearnBlockInput!]
  evaluateBlocks: [EvaluateBlockInput!]
}

input UpdateWaveInput {
  title: String
  sequenceOrder: Int
  xpReward: Int
  maxReattempts: Int
  passingThreshold: Int
  estimatedDuration: Int
  difficulty: Difficulty
  learnBlocks: [LearnBlockInput!]
  evaluateBlocks: [EvaluateBlockInput!]
}

input AnswerInput {
  evaluateBlockId: ID!
  answer: String!
}

type QuestionFeedback {
  evaluateBlockId: ID!
  correct: Boolean!
  correctAnswer: String
  explanation: String
}

type WaveResult {
  score: Int!
  xpEarned: Int!
  totalXp: Int!
  passed: Boolean!
  remainingAttempts: Int
  feedback: [QuestionFeedback!]!
}

input CreateSubscriptionInput {
  tier: Tier!
}

"""
Leaderboard scopes. WEEKLY resets itself every Monday 00:00 UTC.
There is no FRIENDS scope: the platform has no friends model, and a scope that
can only ever return an empty board is a broken feature, not a pending one.
"""
enum LeaderboardScope {
  GLOBAL
  COURSE
  GRADE
  WEEKLY
}

type XpEvent {
  waveId: ID!
  amount: Int!
  totalXp: Int!
  reason: String!
}

type Query {
  me: User!

  courses(filter: CourseFilter, pagination: PaginationInput): CourseConnection!
  myEnrollments: [Course!]!
  course(id: ID!): Course

  lesson(id: ID!): Lesson
  wave(id: ID!): Wave

  progress(courseId: ID): [LessonProgress!]!
  waveProgress(waveId: ID!): WaveProgress

  leaderboard(scope: LeaderboardScope!, courseId: ID, grade: Grade, limit: Int = 50, offset: Int = 0): LeaderboardPage!
  myRank(scope: LeaderboardScope!, courseId: ID): Int

  achievements: [Achievement!]!
}

input UpdateMeInput {
  fullName: String
  grade: Grade
  preferredLanguage: String
}

type Mutation {
  register(input: RegisterInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  refreshToken(refreshToken: String!): AuthPayload!
  logout: Boolean!

  createCourse(input: CreateCourseInput!): Course!
  updateCourse(id: ID!, input: UpdateCourseInput!): Course!
  publishCourse(id: ID!): Course!
  deleteCourse(id: ID!): Boolean!
  createLesson(courseId: ID!, input: CreateLessonInput!): Lesson!
  updateLesson(id: ID!, input: UpdateLessonInput!): Lesson!
  publishLesson(id: ID!): Lesson!
  deleteLesson(id: ID!): Boolean!
  createWave(lessonId: ID!, input: CreateWaveInput!): Wave!
  updateWave(id: ID!, input: UpdateWaveInput!): Wave!
  publishWave(id: ID!): Wave!
  deleteWave(id: ID!): Boolean!

  submitWaveAnswers(waveId: ID!, answers: [AnswerInput!]!, submissionId: String): WaveResult!
  resetWaveAttempts(waveId: ID!): Boolean!
  enrollInCourse(courseId: ID!): Course!

  generateLearnBlocks(prompt: String!, language: String, grade: Grade): [LearnBlock!]!
  generateEvaluateBlocks(content: String!, count: Int = 3): [EvaluateBlock!]!
  translateContent(content: String!, targetLanguage: String!): String!
  generateVisualization(concept: String!, vizType: VizType!, grade: String): String!
  analyzeImage(imageBase64: String!, prompt: String): String!

  createSubscription(input: CreateSubscriptionInput!): UserSubscription!
  cancelSubscription: UserSubscription!
  updateMe(input: UpdateMeInput!): User!
}

type Subscription {
  leaderboardUpdated(scope: LeaderboardScope!, courseId: ID): LeaderboardEntry!
  xpGained: XpEvent!
  achievementUnlocked: Achievement!
  waveCompleted: WaveProgress!
}
