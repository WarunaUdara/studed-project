{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.opencode",
      "!**/src/routeTree.gen.ts",
      "!**/src/styles/index.css",
      "!**/test-results",
      "!**/e2e/loop/snapshots",
      "!**/public/abstract-shapes",
      "!**/src/components/ui/achievement-badge.tsx",
      "!**/src/components/ui/leaderboard-rankings.tsx",
      "!**/src/components/ui/points-badge.tsx",
      "!**/src/components/ui/points-levels-timeline.tsx",
      "!**/src/components/ui/streak-badge.tsx"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noLabelWithoutControl": "off",
        "noSvgWithoutTitle": "off",
        "noStaticElementInteractions": "off",
        "useButtonType": "off",
        "useAriaPropsSupportedByRole": "off",
        "useSemanticElements": "off",
        "useMediaCaption": "off",
        "useKeyWithClickEvents": "off",
        "noNoninteractiveTabindex": "off",
        "noAriaHiddenOnFocusable": "off",
        "useFocusableInteractive": "off",
        "useAriaPropsForRole": "off"
      },
      "complexity": {
        "noImportantStyles": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off"
      },
      "style": {
        "useNodejsImportProtocol": "off",
        "noNonNullAssertion": "off"
      }
    }
  }
}
