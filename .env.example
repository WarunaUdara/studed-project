# Docker Compose runtime configuration. Never commit the real .env file.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173

# These defaults are also available from docker-compose.yml, but explicit local
# values make the service-to-service configuration easy to understand.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-bytes-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-bytes-long
SERVICE_TOKEN=local-dev-service-token-secret
